        <mxCell id="h_rec" value="Reconciliation case — ADR-015" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2020" y="1724" width="620" height="34" as="geometry" />
        </mxCell>
        <mxCell id="rec_op" value="OPEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontSize=14;fontStyle=1;" vertex="1" parent="1">
