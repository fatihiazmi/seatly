        <mxCell id="n_can" value="One table for all three types (RC-06):&lt;br&gt;CUSTOMER_BOOKING, ADMIN_BOOKING, SHOWTIME.&lt;br&gt;Reused key with a different target or&lt;br&gt;fingerprint is an idempotency conflict." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="3400" y="930" width="380" height="120" as="geometry" />
        </mxCell>
