        <mxCell id="rec_rs" value="RESOLVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2480" y="1780" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rec_un" value="UNRESOLVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2940" y="1780" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_rec" value="Opened by PAY-05/06/08/09/11b/13 and by&lt;br&gt;showtime cancellation. PAY-05b opens none —&lt;br&gt;initiation was never sent, so nothing is&lt;br&gt;ambiguous. Nothing in MVP resolves a case&lt;br&gt;by hand; operator scope is inspection only." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="3400" y="1770" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_lock" value="Global lock order — every competing action uses it&lt;br&gt;&lt;br&gt;  1. showtime row&lt;br&gt;  2. showtime_seats, ordered by seat_id ASC&lt;br&gt;  3. holds, then payments, then bookings, by id ASC&lt;br&gt;  4. cancellation / reconciliation rows&lt;br&gt;  5. audit and outbox rows last, in the same transaction&lt;br&gt;&lt;br&gt;Never acquire the showtime lock after a seat, hold, payment or booking lock.&lt;br&gt;Retry the whole transaction on deadlock, never a partial mutation, and never&lt;br&gt;under a new command identity." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="2200" width="1680" height="260" as="geometry" />
        </mxCell>
        <mxCell id="n_key" value="Reading this diagram&lt;br&gt;&lt;br&gt;  white box      non-terminal state&lt;br&gt;  green box      terminal state&lt;br&gt;  solid arrow    normal path&lt;br&gt;  dashed amber   exception, cancellation or reconciliation path&lt;br&gt;&lt;br&gt;A worker tick, HTTP request or callback receipt is only a request to attempt&lt;br&gt;a transition — never proof that it is still eligible. Guards are re-evaluated&lt;br&gt;after locks are held, using PostgreSQL time." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="2020" y="2200" width="1680" height="260" as="geometry" />
        </mxCell>
